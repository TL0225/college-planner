#!/usr/bin/env bash
# Regenerate Cursor feature-boundary rules when feature folders or the manifest change.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
if [[ -z "$STAGED" ]]; then
  exit 0
fi

needs_regen=false
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  case "$path" in
    College/Features/*|College/Features/*/*)
      needs_regen=true
      break
      ;;
    scripts/feature-touch-manifest.json|scripts/generate-cursor-feature-rules.py)
      needs_regen=true
      break
      ;;
  esac
done <<<"$STAGED"

if [[ "$needs_regen" != true ]]; then
  if ! python3 scripts/generate-cursor-feature-rules.py --check >/dev/null 2>&1; then
    needs_regen=true
  fi
fi

if [[ "$needs_regen" != true ]]; then
  exit 0
fi

echo "pre-commit: regenerating Cursor feature rules…"
python3 scripts/generate-cursor-feature-rules.py --write

git add .cursor/rules/feature-boundaries-master.mdc .cursor/rules/features/

if ! git diff --cached --quiet -- .cursor/rules/feature-boundaries-master.mdc .cursor/rules/features/ 2>/dev/null; then
  echo "pre-commit: staged updated .cursor/rules/feature-* files"
fi

exit 0
