{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default College desktop capabilities",
  "windows": ["main", "lms-*", "career-apply-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default",
    "fs:default",
    "notification:default",
    "process:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "typst-compile",
          "cmd": "typst",
          "args": ["compile", { "validator": "\\S+" }, { "validator": "\\S+" }]
        },
        {
          "name": "typst-compile-exe",
          "cmd": "typst.exe",
          "args": ["compile", { "validator": "\\S+" }, { "validator": "\\S+" }]
        }
      ]
    },
    "updater:default"
  ]
}
